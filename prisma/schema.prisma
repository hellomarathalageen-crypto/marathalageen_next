generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// NEXTAUTH CORE TABLES
// -----------------------------------------------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials login
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("USER") // USER, ADMIN

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  preferences   PartnerPreference?
  
  sentInterests     Interest[] @relation("SentInterests")
  receivedInterests Interest[] @relation("ReceivedInterests")
  messages          Message[]  @relation("SentMessages")
  receivedMessages  Message[]  @relation("ReceivedMessages")

  shortlists        Shortlist[]
  subscriptions     Subscription[]
}

// -----------------------------------------------------------------------------
// MATRIMONIAL DOMAIN TABLES
// -----------------------------------------------------------------------------

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileCreatedBy String? // Self, Parents, Sibling, Relative
  gender           String?
  firstName        String
  lastName         String
  mobile           String?
  dateOfBirth      DateTime?
  maritalStatus    String?

  height           String?
  weight           String?
  city             String?
  state            String?
  country          String?

  // Cultural / Lineage
  religion         String?  @default("Hindu")
  community        String?  // Maratha, 96 Kuli Maratha, Kunbi Maratha, Deshastha Maratha
  subCommunity     String?
  gotra            String?
  devak            String?  // देवक (e.g. Kalamb, Panchpallav, Suryakant, Garud)
  kuldaivat        String?  // कुलदैवत (e.g. Khandoba Jejuri, Bhavani Tuljapur, Mahalaxmi Kolhapur)
  nativePlace      String?  // मूळ गाव / District
  mamaGotra        String?  // मामाचे कुल

  // Horoscope / Kundali
  rashi            String?  // Mesh, Vrishabh, Mithun, etc.
  nakshatra        String?  // Ashwini, Bharani, Rohini, etc.
  charan           String?  // 1, 2, 3, 4
  gan              String?  // Deva, Manushya, Rakshasa
  nadi             String?  // Aadi, Madhya, Antya
  manglik          String?  @default("Non-Manglik") // Non-Manglik, Manglik, Anshik Manglik
  birthTime        String?
  birthPlace       String?

  // Education & Career
  education        String?
  college          String?
  profession       String?
  company          String?
  annualIncome     String?

  // Lifestyle & Habits
  diet             String?  @default("Non-Veg") // Vegetarian, Non-Veg, Eggetarian
  drinking         String?  @default("No")
  smoking          String?  @default("No")
  about            String?  @db.Text
  motherTongue     String?  @default("Marathi")

  // Family Background
  familyType       String?  @default("Nuclear") // Nuclear, Joint
  familyValues     String?  @default("Moderate") // Traditional, Moderate, Liberal
  fatherOccupation String?
  motherOccupation String?
  brothersCount    Int?     @default(0)
  brothersMarried  Int?     @default(0)
  sistersCount     Int?     @default(0)
  sistersMarried   Int?     @default(0)

  // Trust, Verification & Privacy
  isVerified          Boolean  @default(false)
  profileCompleteness Int      @default(20)
  photoPrivacy        String   @default("all") // all, members, request
  phonePrivacy        String   @default("premium") // premium, request
  
  photos           Photo[]
  shortlistedBy    Shortlist[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  isPrimary Boolean  @default(false)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Shortlist {
  id              String   @id @default(cuid())
  userId          String
  targetProfileId String
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetProfile   Profile  @relation(fields: [targetProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, targetProfileId])
}

model PartnerPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  minAge          Int?
  maxAge          Int?
  minHeight       String?
  maxHeight       String?
  maritalStatus   String?
  religion        String?
  communities     String?
  education       String?
  profession      String?
  city            String?
  diet            String?
  manglik         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Interest {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  status      String   @default("pending") // pending, accepted, rejected
  message     String?  @db.Text
  
  sender      User     @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([senderId, receiverId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  plan        String   @default("FREE") // FREE, PREMIUM, PREMIUM_PLUS
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  amount      Float    @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
